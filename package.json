{
  "name": "ai-interview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "preview": "vite preview --host",
    "setup": "npm install && npm install --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "node scripts/start-client.js",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "lint": "eslint .",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "dotenv": "^17.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
