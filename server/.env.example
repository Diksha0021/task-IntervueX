# Server port
PORT=5000

# MongoDB connection string (optional — leave unset to use local JSON files, no Mongo required)
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ai_interview?retryWrites=true&w=majority

# JWT secret for auth tokens
JWT_SECRET=change-this-to-a-long-random-string

# Transcription (after interview merge): auto | whisper | deepgram | mock
# TRANSCRIPTION_PROVIDER=auto
# OPENAI_API_KEY=sk-...          # Whisper via OpenAI API
# OPENAI_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1
# DEEPGRAM_API_KEY=your_deepgram_key
# TRANSCRIPTION_MAX_ATTEMPTS=3
# TRANSCRIPTION_RETRY_BASE_MS=2000
# TRANSCRIPTION_RETRY_MAX_MS=16000

# Environment
NODE_ENV=development

# Recording storage: local (default) or s3
# STORAGE_PROVIDER=local
# PUBLIC_API_URL=https://intervuex-api-driw.onrender.com

# AWS S3 (when STORAGE_PROVIDER=s3)
# AWS_S3_BUCKET=your-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=          # optional, for MinIO / compatible APIs
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_S3_SIGNED_URL_TTL=3600
